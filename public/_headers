# Netlify Headers Configuration
# Optimized caching and byte-range request streaming for video and audio assets

/videos/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
  Content-Type: video/mp4

/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
  Content-Type: audio/mpeg

/audios/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
  Content-Type: audio/mpeg

/*.mp3
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
  Content-Type: audio/mpeg

/photos/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
